<Window x:Class="HouseholdAccountBook.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:properties="clr-namespace:HouseholdAccountBook.Properties"
        xmlns:vmw="clr-namespace:HouseholdAccountBook.ViewModels.Windows"
        xmlns:attached="clr-namespace:HouseholdAccountBook.Views.AttachedProperties"
        xmlns:behaviors="clr-namespace:HouseholdAccountBook.Views.Behaviors"
        xmlns:controls="clr-namespace:HouseholdAccountBook.Views.UserControls"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.Title_SettingsWindow}" Height="700" Width="1050" WindowStyle="ToolWindow"
        Closing="SettingsWindow_Closing">
    
    <Window.DataContext>
        <vmw:SettingsWindowViewModel x:Name="WVM"/>
    </Window.DataContext>
    
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+F4" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Style>
        <StaticResource ResourceKey="BusyCursor"/>
    </Window.Style>

    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <!-- ファイル -->
            <MenuItem Header="{x:Static properties:Resources.Menu_File}">
                <MenuItem Header="{x:Static properties:Resources.Menu_File_Exit}" Command="{Binding CloseCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <!-- 表示 -->
            <MenuItem Header="{x:Static properties:Resources.Menu_View}">
                <!-- アセット表示 -->
                <MenuItem Header="{x:Static properties:Resources.Menu_View_AssetDisplayMode}" IsCheckable="True" IsChecked="{Binding App_AssetDisplayMode, Source={StaticResource Settings}}"/>
                <!-- デバッグモード -->
                <MenuItem Header="{x:Static properties:Resources.Menu_View_DebugMode}" IsCheckable="True" IsChecked="{Binding App_IsDebug, Source={StaticResource Settings}}"/>
            </MenuItem>
        </Menu>
        
        <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="5"
                    SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="SettingsTabControl_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Height" Value="75"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- アセット設定 -->
            <TabItem x:Name="_AssetTab" DataContext="{Binding AssetTabVM}" Visibility="{Binding App_AssetDisplayMode, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}">
                <TabItem.Header>
                    <TextBlock Text="{x:Static properties:Resources.TabHeader_AssetSettings}" TextAlignment="Center"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- アセット一覧 -->
                    <GroupBox Grid.Column="0" Header="{x:Static properties:Resources.GroupHeader_AssetList}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="5" Orientation="Horizontal">
                                <Button Content="{x:Static properties:Resources.Button_Add}" Width="50" Command="{Binding AddAssetCommand}" ToolTip="Ctrl++"/>
                                <Button Content="{x:Static properties:Resources.Button_Delete}" Width="50" Command="{Binding DeleteAssetCommand}" ToolTip="Del"/>
                                <Button Content="{x:Static properties:Resources.Button_RaiseSortOrder}" Width="25" Command="{Binding RaiseAssetSortOrderCommand}" ToolTip="Ctrl+↑"/>
                                <Button Content="{x:Static properties:Resources.Button_DropSortOrder}" Width="25" Command="{Binding DropAssetSortOrderCommand}" ToolTip="Ctrl+↓"/>
                                <Button Content="{x:Static properties:Resources.Button_SetDefault}" Width="90" Command="{Binding SetDefaultAssetCommand}"/>
                            </StackPanel>

                            <ListBox Grid.Row="1" Margin="5" 
                                     ItemsSource="{Binding AssetListVM.ItemList}" SelectedItem="{Binding AssetListVM.SelectedItem}">
                                <ListBox.InputBindings>
                                    <KeyBinding Gesture="Ctrl+OEMPlus" Command="{Binding DataContext.AddAssetCommand, ElementName=_AssetTab}"/>
                                    <KeyBinding Gesture="Ctrl+Add" Command="{Binding DataContext.AddAssetCommand, ElementName=_AssetTab}"/>
                                    <KeyBinding Gesture="Delete" Command="{Binding DataContext.DeleteAssetCommand, ElementName=_AssetTab}"/>
                                    <KeyBinding Gesture="Ctrl+Up" Command="{Binding DataContext.RaiseAssetSortOrderCommand, ElementName=_AssetTab}"/>
                                    <KeyBinding Gesture="Ctrl+Down" Command="{Binding DataContext.DropAssetSortOrderCommand, ElementName=_AssetTab}"/>
                                </ListBox.InputBindings>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsDefault}" IsEnabled="False"/>
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                    <!-- アセット情報 -->
                    <Grid Grid.Column="2" Grid.IsSharedSizeScope="True" DataContext="{Binding DisplayedAssetSettingVM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <GroupBox Header="{x:Static properties:Resources.GroupHeader_AssetInformation}">
                                    <GroupBox.InputBindings>
                                        <KeyBinding Gesture="Ctrl+S" Command="{Binding DataContext.SaveAssetInfoCommand, ElementName=_AssetTab}"/>
                                    </GroupBox.InputBindings>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                            <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30" SharedSizeGroup="Button" />
                                        </Grid.ColumnDefinitions>

                                        <!-- アセットID -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="Asset Id"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{Binding Id, TargetNullValue='--'}"/>

                                        <!-- ソート順 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{x:Static properties:Resources.TextBlock_SortOrder}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{Binding SortOrder}"/>

                                        <!-- アセット名 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AssetName}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                 Text="{Binding NameVM.InputedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 attached:DirtyIndicator.IsDirty="{Binding NameVM.IsDirty}"/>

                                        <!-- アセット種別 -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AssetKind}"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                  ItemsSource="{Binding AssetKindListVM.ItemList}" SelectedItem="{Binding AssetKindListVM.SelectedItem}" DisplayMemberPath="Value"
                                                  attached:DirtyIndicator.IsDirty="{Binding AssetKindListVM.IsDirty}"/>

                                        <!-- アセットコード -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AssetCode}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                 Text="{Binding AssetCodeVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                 attached:DirtyIndicator.IsDirty="{Binding AssetCodeVM.IsDirty}"/>

                                        <!-- 主単位 -->
                                        <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Header="{x:Static properties:Resources.GroupHeader_MainUnit}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                    <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30" SharedSizeGroup="Button" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- 単位(前置) -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_UnitPrefix}"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Margin="5" 
                                                         Text="{Binding PrefixVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding PrefixVM.IsDirty}"/>
                                                <!-- 単位(後置) -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_UnitSuffix}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="5" 
                                                         Text="{Binding SuffixVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding SuffixVM.IsDirty}"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- ベースレート -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="5"
                                                   Text="{x:Static properties:Resources.TextBlock_AssetBaseRate}"/>
                                        <controls:NumericUpDown Grid.Row="6" Grid.Column="1" Margin="5"
                                                                Value="{Binding BaseRateVM.InputedValue}" MinValue="0" IsFloating="True"
                                                                attached:DirtyIndicator.IsDirty="{Binding BaseRateVM.IsDirty}"/>

                                        <!-- スケール -->
                                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AssetScale}"/>
                                        <controls:NumericUpDown Grid.Row="7" Grid.Column="1" Margin="5" Value="{Binding ScaleVM.InputedValue}" MinValue="0"
                                                                attached:DirtyIndicator.IsDirty="{Binding ScaleVM.IsDirty}"/>

                                        <!-- 補助単位 -->
                                        <GroupBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" Header="{x:Static properties:Resources.GroupHeader_SubUnit}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                    <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30" SharedSizeGroup="Button" />
                                                </Grid.ColumnDefinitions>

                                                <!-- サブ単位名 -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_SubUnitName}"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                         Text="{Binding SubunitNameVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding SubunitNameVM.IsDirty}"/>
                                                <!-- サブ単位(前置) -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_UnitPrefix}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="5" 
                                                         Text="{Binding SubPrefixVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding SubPrefixVM.IsDirty}"/>
                                                <!-- サブ単位(後置) -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_UnitSuffix}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" 
                                                         Text="{Binding SubSuffixVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding SubSuffixVM.IsDirty}"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 保存 -->
                        <Button Grid.Row="1" Margin="5" 
                                Content="{x:Static properties:Resources.Button_Save}"
                                Command="{Binding DataContext.SaveAssetInfoCommand, ElementName=_AssetTab}" ToolTip="Ctrl+S"/>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- 帳簿設定 -->
            <TabItem x:Name="_AccountTab" DataContext="{Binding AccountTabVM}">
                <TabItem.Header>
                    <TextBlock Text="{x:Static properties:Resources.TabHeader_AccountSettings}" TextAlignment="Center"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 帳簿一覧 -->
                    <GroupBox Grid.Column="0" Header="{x:Static properties:Resources.GroupHeader_AccountList}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="5" Orientation="Horizontal">
                                <Button Content="{x:Static properties:Resources.Button_Add}" Width="50" Command="{Binding AddAccountCommand}" ToolTip="Ctrl++"/>
                                <Button Content="{x:Static properties:Resources.Button_Delete}" Width="50" Command="{Binding DeleteAccountCommand}" ToolTip="Del"/>
                                <Button Content="{x:Static properties:Resources.Button_RaiseSortOrder}" Width="25" Command="{Binding RaiseAccountSortOrderCommand}" ToolTip="Ctrl+↑"/>
                                <Button Content="{x:Static properties:Resources.Button_DropSortOrder}" Width="25" Command="{Binding DropAccountSortOrderCommand}" ToolTip="Ctrl+↓"/>
                            </StackPanel>

                            <ListBox Grid.Row="1" Margin="5" 
                                     ItemsSource="{Binding AccountListVM.ItemList}" SelectedItem="{Binding AccountListVM.SelectedItem}" DisplayMemberPath="Name">
                                <ListBox.InputBindings>
                                    <KeyBinding Gesture="Ctrl+OEMPlus" Command="{Binding DataContext.AddAccountCommand, ElementName=_AccountTab}"/>
                                    <KeyBinding Gesture="Ctrl+Add" Command="{Binding DataContext.AddAccountCommand, ElementName=_AccountTab}"/>
                                    <KeyBinding Gesture="Delete" Command="{Binding DataContext.DeleteAccountCommand, ElementName=_AccountTab}"/>
                                    <KeyBinding Gesture="Ctrl+Up" Command="{Binding DataContext.RaiseAccountSortOrderCommand, ElementName=_AccountTab}"/>
                                    <KeyBinding Gesture="Ctrl+Down" Command="{Binding DataContext.DropAccountSortOrderCommand, ElementName=_AccountTab}"/>
                                </ListBox.InputBindings>
                            </ListBox>
                        </Grid>
                    </GroupBox>
                    
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                    <Grid Grid.Column="2" Grid.IsSharedSizeScope="True" DataContext="{Binding DisplayedAccountSettingVM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- 帳簿情報 -->
                        <ScrollViewer Grid.Row="0">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <GroupBox Header="{x:Static properties:Resources.GroupHeader_AccountInformation}">
                                    <GroupBox.InputBindings>
                                        <KeyBinding Gesture="Ctrl+S" Command="{Binding DataContext.SaveAccountInfoCommand, ElementName=_AccountTab}"/>
                                    </GroupBox.InputBindings>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                            <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30" SharedSizeGroup="Button" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 帳簿ID -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="Account Id"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{Binding Id, TargetNullValue='--'}"/>

                                        <!-- ソート順 -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{x:Static properties:Resources.TextBlock_SortOrder}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{Binding SortOrder}"/>

                                        <!-- 帳簿名 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AccountName}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                 Text="{Binding NameVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                 attached:DirtyIndicator.IsDirty="{Binding NameVM.IsDirty}"/>

                                        <!-- 帳簿種別 -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_AccountKind}"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                  ItemsSource="{Binding AccountKindListVM.ItemList}" SelectedItem="{Binding AccountKindListVM.SelectedItem}" DisplayMemberPath="Value"
                                                  attached:DirtyIndicator.IsDirty="{Binding AccountKindListVM.IsDirty}"/>

                                        <!-- 備考 -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_Remark}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                 Text="{Binding RemarkVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                 attached:DirtyIndicator.IsDirty="{Binding RemarkVM.IsDirty}"/>

                                        <!-- アセット -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="5" Visibility="{Binding App_AssetDisplayMode, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                   Text="{x:Static properties:Resources.TextBlock_Asset}"/>
                                        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Visibility="{Binding App_AssetDisplayMode, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                                  ItemsSource="{Binding AssetListVM.ItemList}" SelectedItem="{Binding AssetListVM.SelectedItem}" DisplayMemberPath="Name"
                                                  attached:DirtyIndicator.IsDirty="{Binding AssetListVM.IsDirty}"/>

                                        <!-- 初期残高 -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="5" 
                                                   Text="{x:Static properties:Resources.TextBlock_InitialBalance}"/>
                                        <controls:NumericUpDown Grid.Row="6" Grid.Column="1" Margin="5" Value="{Binding InitialValueVM.InputedValue}" Scale="{Binding InitialValueScale}" MinValue="-79228162514264337593543950335"
                                                                attached:DirtyIndicator.IsDirty="{Binding InitialValueVM.IsDirty}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Margin="5" HorizontalAlignment="Right" Text="{Binding InputedInitialValueStr}"/>

                                        <!-- 期間情報 -->
                                        <GroupBox Grid.Row="7" Grid.ColumnSpan="4" Header="{x:Static properties:Resources.GroupHeader_PeriodInformation}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="Header"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="200" SharedSizeGroup="DateTime"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition SharedSizeGroup="Button"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 開始日 -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_StartDate}"/>
                                                <CheckBox Grid.Row="0" Grid.Column="1" Margin="5" 
                                                          Content="{x:Static properties:Resources.CheckBox_Setting}" IsChecked="{Binding StartDateExistsVM.InputedValue}"
                                                          attached:DirtyIndicator.IsDirty="{Binding StartDateExistsVM.IsDirty}"/>
                                                <controls:DateTimePicker Grid.Row="0" Grid.Column="2" Margin="1" IsEnabled="{Binding StartDateExistsVM.InputedValue}"
                                                                         DateFormat="yyyy-MM-dd" SelectedDateOnly="{Binding PeriodStartVM.InputedValue}"
                                                                         attached:DirtyIndicator.IsDirty="{Binding PeriodStartVM.IsDirty}"/>

                                                <!-- 終了日 -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" 
                                                           Text="{x:Static properties:Resources.TextBlock_EndDate}"/>
                                                <CheckBox Grid.Row="1" Grid.Column="1" Margin="5" 
                                                          Content="{x:Static properties:Resources.CheckBox_Setting}" IsChecked="{Binding EndDateExistsVM.InputedValue}"
                                                          attached:DirtyIndicator.IsDirty="{Binding EndDateExistsVM.IsDirty}"/>
                                                <controls:DateTimePicker Grid.Row="1" Grid.Column="2" Margin="1" IsEnabled="{Binding EndDateExistsVM.InputedValue}"
                                                                         DateFormat="yyyy-MM-dd" SelectedDateOnly="{Binding PeriodEndVM.InputedValue}"
                                                                         attached:DirtyIndicator.IsDirty="{Binding PeriodEndVM.IsDirty}"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- 支払情報 -->
                                        <GroupBox Grid.Row="8" Grid.ColumnSpan="4" Header="{x:Static properties:Resources.GroupHeader_PaymentInformation}" IsEnabled="{Binding NeedToPay}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="Header"/>
                                                    <ColumnDefinition SharedSizeGroup="Number"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition SharedSizeGroup="Button"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 支払い元帳簿 -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_PaymentAccount}"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                          ItemsSource="{Binding DebitAccountListVM.ItemList}" SelectedItem="{Binding DebitAccountListVM.SelectedItem}" DisplayMemberPath="Name"
                                                          attached:DirtyIndicator.IsDirty="{Binding DebitAccountListVM.IsDirty}"/>
                                                <!-- 支払日 -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_PaymentDate}"/>
                                                <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="5" 
                                                                        Value="{Binding PayDayVM.InputedValue}" MinValue="1" MaxValue="31"
                                                                        attached:DirtyIndicator.IsDirty="{Binding PayDayVM.IsDirty}"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- CSV情報 -->
                                        <GroupBox Grid.Row="9" Grid.ColumnSpan="4" Header="{x:Static properties:Resources.GroupHeader_CSVInformation}" IsEnabled="{Binding CsvDataExists}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="Header"/>
                                                    <ColumnDefinition SharedSizeGroup="Number"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition SharedSizeGroup="Button"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- フォルダパス -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5"
                                                           Text="{x:Static properties:Resources.TextBlock_FolderPath}"/>
                                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                                         Text="{Binding CsvFolderPathVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                         attached:DirtyIndicator.IsDirty="{Binding CsvFolderPathVM.IsDirty}"/>
                                                <Button Grid.Row="0" Grid.Column="3" Margin="5" Content="..." 
                                                        Command="{Binding DataContext.SelectCsvFolderPathCommand, ElementName=_AccountTab}"/>

                                                <!-- エンコード -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5"
                                                           Text="{x:Static properties:Resources.TextBlock_TextEncoding}"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"
                                                          ItemsSource="{Binding TextEncodingListVM.ItemList}" SelectedItem="{Binding TextEncodingListVM.SelectedItem}" DisplayMemberPath="Value"
                                                          attached:DirtyIndicator.IsDirty="{Binding TextEncodingListVM.IsDirty}"/>

                                                <!-- 列番号 -->
                                                <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" 
                                                          Header="{x:Static properties:Resources.GroupHeader_ColumnIndex}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition SharedSizeGroup="Header"/>
                                                            <ColumnDefinition SharedSizeGroup="Number"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition SharedSizeGroup="Button"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 日付 -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" 
                                                                   Text="{x:Static properties:Resources.TextBlock_Date}"/>
                                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5"
                                                                                Value="{Binding ActDateIndexVM.InputedValue, TargetNullValue=''}" MinValue="1"
                                                                                attached:DirtyIndicator.IsDirty="{Binding ActDateIndexVM.IsDirty}"/>

                                                        <!-- 支出 -->
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" 
                                                                   Text="{x:Static properties:Resources.TextBlock_Expenses}"/>
                                                        <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="5"
                                                                                Value="{Binding ExpensesIndexVM.InputedValue, TargetNullValue=''}" MinValue="1"
                                                                                attached:DirtyIndicator.IsDirty="{Binding ExpensesIndexVM.IsDirty}"/>

                                                        <!-- 項目名 -->
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" 
                                                                   Text="{x:Static properties:Resources.TextBlock_ItemName}"/>
                                                        <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Margin="5"
                                                                                Value="{Binding ItemNameIndexVM.InputedValue, TargetNullValue=''}" MinValue="1"
                                                                                attached:DirtyIndicator.IsDirty="{Binding ItemNameIndexVM.IsDirty}"/>
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 保存 -->
                        <Button Grid.Row="1" Margin="5" 
                                Content="{x:Static properties:Resources.Button_Save}"
                                Command="{Binding DataContext.SaveAccountInfoCommand, ElementName=_AccountTab}" ToolTip="Ctrl+S"/>

                        <!-- 関連付け -->
                        <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.GroupHeader_Linkage}">
                            <Grid>
                                <ListBox Margin="5" ItemsSource="{Binding RelationListVM.ItemList}" SelectedItem="{Binding RelationListVM.SelectedItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsRelated}"
                                                          Command="{Binding DataContext.ChangeAccountRelationCommand, ElementName=_AccountTab}"
                                                          CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Self}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 項目設定 -->
            <TabItem x:Name="_ItemTab" DataContext="{Binding ItemTabVM}">
                <TabItem.Header>
                    <TextBlock Text="{x:Static properties:Resources.TabHeader_ItemSettings}" TextAlignment="Center"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 項目一覧 -->
                    <GroupBox Grid.Column="0" Header="{x:Static properties:Resources.GroupHeader_ItemList}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="5" Orientation="Horizontal">
                                <Button Width="80" Content="{x:Static properties:Resources.Button_AddCategory}" Command="{Binding AddCategoryCommand}" ToolTip="Shift+Ctrl++"/>
                                <Button Width="80" Content="{x:Static properties:Resources.Button_AddItem}" Command="{Binding AddItemCommand}" ToolTip="Ctrl++"/>
                                <Button Width="50" Content="{x:Static properties:Resources.Button_Delete}" Command="{Binding DeleteItemCommand}" ToolTip="Delete"/>
                                <Button Width="25" Content="{x:Static properties:Resources.Button_RaiseSortOrder}" Command="{Binding RaiseItemSortOrderCommand}" ToolTip="Ctrl+↑"/>
                                <Button Width="25" Content="{x:Static properties:Resources.Button_DropSortOrder}" Command="{Binding DropItemSortOrderCommand}" ToolTip="Ctrl+↓"/>
                            </StackPanel>

                            <TreeView x:Name="hierarchicalTreeView" Grid.Row="1" Margin="5" ItemsSource="{Binding ItemTreeVMList}"
                                      SelectedItemChanged="TreeView_SelectedItemChanged">
                                <TreeView.InputBindings>
                                    <KeyBinding Gesture="Shift+Ctrl+OEMPlus" Command="{Binding DataContext.AddCategoryCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Shift+Ctrl+Add" Command="{Binding DataContext.AddCategoryCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Ctrl+OEMPlus" Command="{Binding DataContext.AddItemCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Ctrl+Add" Command="{Binding DataContext.AddItemCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Delete" Command="{Binding DataContext.DeleteItemCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Ctrl+Up" Command="{Binding DataContext.RaiseItemSortOrderCommand, ElementName=_ItemTab}"/>
                                    <KeyBinding Gesture="Ctrl+Down" Command="{Binding DataContext.DropItemSortOrderCommand, ElementName=_ItemTab}"/>
                                </TreeView.InputBindings>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Setter Property="IsSelected" Value="{Binding SelectFlag}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <i:Interaction.Behaviors>
                                    <behaviors:BindSelectedItemToTreeViewBehavior SelectedItem="{Binding SelectedItemTreeVM}"/>
                                </i:Interaction.Behaviors>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="viewmodels:HierarchicalViewModel" 
                                                              ItemsSource="{Binding ChildrenVMList}">
                                        <TextBlock Text="{Binding Name}"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                    <Grid Grid.Column="2" DataContext="{Binding DisplayedItemSettingVM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0.3*"/>
                            <RowDefinition Height="0.3*"/>
                            <RowDefinition Height="0.3*"/>
                        </Grid.RowDefinitions>
                        <!-- 項目情報 -->
                        <GroupBox Grid.Row="0" Header="{x:Static properties:Resources.GroupHeader_ItemInformation}">
                            <GroupBox.InputBindings>
                                <KeyBinding Gesture="Ctrl+S" Command="{Binding DataContext.SaveItemInfoCommand, ElementName=_ItemTab}"/>
                            </GroupBox.InputBindings>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ID -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                           Text="Id"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                           Text="{Binding Id, TargetNullValue='--'}"/>
                                
                                <!-- ソート順 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                           Text="{x:Static properties:Resources.TextBlock_SortOrder}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="5" Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                           Text="{Binding SortOrder}"/>
                                
                                <!-- 項目名/分類名 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
                                           Text="{x:Static properties:Resources.TextBlock_ItemName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Item">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="5"
                                           Text="{x:Static properties:Resources.TextBlock_CategoryName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Category">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" 
                                         Text="{Binding NameVM.InputedValue, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRenamable, Converter={StaticResource NegationConverter}}"
                                         attached:DirtyIndicator.IsDirty="{Binding NameVM.IsDirty}"/>

                                <!-- アセット -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" Visibility="{Binding App_AssetDisplayMode, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                           Text="{x:Static properties:Resources.TextBlock_Asset}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Visibility="{Binding App_AssetDisplayMode, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                          ItemsSource="{Binding AssetListVM.ItemList}" SelectedItem="{Binding AssetListVM.SelectedItem}" DisplayMemberPath="Name"
                                          attached:DirtyIndicator.IsDirty="{Binding AssetListVM.IsDirty}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Item">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <!-- 項目種別 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_ItemKind}"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"
                                          ItemsSource="{Binding ItemKindListVM.ItemList}" SelectedItem="{Binding ItemKindListVM.SelectedItem}" DisplayMemberPath="Value"
                                          attached:DirtyIndicator.IsDirty="{Binding ItemKindListVM.IsDirty}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Item">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Content="{x:Static properties:Resources.Button_Save}" 
                                        Command="{Binding DataContext.SaveItemInfoCommand, ElementName=_ItemTab}" ToolTip="Ctrl+S"/>
                            </Grid>
                        </GroupBox>
                        
                        <!-- 関連付け -->
                        <GroupBox Grid.Row="1" Header="{x:Static properties:Resources.GroupHeader_Linkage}">
                            <ListBox Margin="5" ItemsSource="{Binding RelationListVM.ItemList}" SelectedItem="{Binding RelationListVM.SelectedItem}" IsEnabled="{Binding IsSettable}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsRelated}"
                                                      Command="{Binding DataContext.ChangeItemRelationCommand, ElementName=_ItemTab}"
                                                      CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        
                        <!-- 店舗情報 -->
                        <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.GroupHeader_Shop}">
                            <DataGrid Margin="5" x:Name="shopDataGrid" 
                                      ItemsSource="{Binding ShopListVM.ItemList}" SelectedItem="{Binding ShopListVM.SelectedItem}" IsEnabled="{Binding IsSettable}"
                                      IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="True"
                                      HorizontalGridLinesBrush="#FFC0C0C0" VerticalGridLinesBrush="#FFC0C0C0" AlternatingRowBackground="#FFFFFFE0" FontSize="10.5" FontFamily="Meiryo">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.InputBindings>
                                    <KeyBinding Gesture="Delete" Command="{Binding DataContext.DeleteShopNameCommand, ElementName=_ItemTab}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_ShopName}" Width="*" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_UsageCount}" Width="*" Binding="{Binding UsedCount}"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_LastUsageDate}" Width="*" Binding="{Binding CurrentActTime, StringFormat='yyyy-MM-dd', TargetNullValue='-'}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        
                        <!-- 備考情報 -->
                        <GroupBox Grid.Row="3" Header="{x:Static properties:Resources.GroupHeader_Remark}">
                            <DataGrid Margin="5" x:Name="remarkDataGrid" 
                                      ItemsSource="{Binding RemarkListVM.ItemList}" SelectedItem="{Binding RemarkListVM.SelectedItem}" IsEnabled="{Binding IsSettable}"
                                      IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="True"
                                      HorizontalGridLinesBrush="#FFC0C0C0" VerticalGridLinesBrush="#FFC0C0C0" AlternatingRowBackground="#FFFFFFE0" FontSize="10.5" FontFamily="Meiryo">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.InputBindings>
                                    <KeyBinding Gesture="Delete" Command="{Binding DataContext.DeleteRemarkCommand, ElementName=_ItemTab}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_Remark}" Width="*" Binding="{Binding Remark}"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_UsageCount}" Width="*" Binding="{Binding UsedCount}"/>
                                    <DataGridTextColumn Header="{x:Static properties:Resources.ColumnHeader_LastUsageDate}" Width="*" Binding="{Binding CurrentActTime, StringFormat='yyyy-MM-dd', TargetNullValue='-'}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- DB設定 -->
            <TabItem x:Name="_DbTab" DataContext="{Binding DbTabVM}">
                <TabItem.Header>
                    <TextBlock Text="{x:Static properties:Resources.TabHeader_DbSettings}" TextAlignment="Center"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- 接続情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_DataBaseInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- SQLite -->
                                    <GroupBox Grid.Row="0" Grid.Column="0" IsEnabled="{Binding DBKindVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SQLite}">
                                        <GroupBox.Header>
                                            <RadioButton Content="{x:Static properties:Resources.GroupHeader_SQLite}" 
                                                         IsChecked="{Binding DBKindVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SQLite}"
                                                         attached:DirtyIndicator.IsDirty="{Binding DBKindVM.IsDirty}" GroupName="DBkindGroup" IsEnabled="False"/>
                                        </GroupBox.Header>
                                        <Grid DataContext="{Binding SQLiteSettingVM}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30" SharedSizeGroup="Button"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- DBファイル名 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_SQLite_DBFilePath}" Margin="5" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="1" Text="{Binding DBFilePathVM.InputedValue}" IsReadOnly="True"
                                                     attached:DirtyIndicator.IsDirty="{Binding DBFilePathVM.IsDirty}"/>
                                            <!-- キャッシュサイズ -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_SQLite_CacheSize}" Margin="5" VerticalAlignment="Center"/>
                                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="5" Value="{Binding CacheSizeVM.InputedValue}" MinValue="0" MaxValue="1024"
                                                                    attached:DirtyIndicator.IsDirty="{Binding CacheSizeVM.IsDirty}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="MB" Margin="5" VerticalAlignment="Center"/>
                                            <!-- メモリマップドI/Oサイズ -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static properties:Resources.TextBlock_SQLite_MmapSize}" Margin="5" VerticalAlignment="Center"/>
                                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Margin="5" Value="{Binding MmapSizeVM.InputedValue}" MinValue="0" MaxValue="1024"
                                                                    attached:DirtyIndicator.IsDirty="{Binding MmapSizeVM.IsDirty}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="MB" Margin="5" VerticalAlignment="Center"/>
                                        </Grid>
                                    </GroupBox>
                                    <!-- PostgreSQL -->
                                    <GroupBox Grid.Row="1" Grid.Column="0" IsEnabled="{Binding DBKindVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PostgreSQL}">
                                        <GroupBox.Header>
                                            <RadioButton Content="{x:Static properties:Resources.GroupHeader_PostgreSQL}" 
                                                         IsChecked="{Binding DBKindVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PostgreSQL}"
                                                         attached:DirtyIndicator.IsDirty="{Binding DBKindVM.IsDirty}" GroupName="DBKindGroup" IsEnabled="False"/>
                                        </GroupBox.Header>
                                        <Grid DataContext="{Binding PostgreSQLDBSettingVM}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30" SharedSizeGroup="Button"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="pg_dump.exe" Margin="5" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding DumpExePathVM.InputedValue}" IsReadOnly="True"
                                                     attached:DirtyIndicator.IsDirty="{Binding DumpExePathVM.IsDirty}"/>
                                            <Button Grid.Row="0" Grid.Column="2" Margin="5" Content="..."
                                                    Command="{Binding DataContext.SelectPgDumpFilePathCommand, ElementName=_DbTab}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="pg_restore.exe" Margin="5" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding RestoreExePathVM.InputedValue}" IsReadOnly="True"
                                                     attached:DirtyIndicator.IsDirty="{Binding RestoreExePathVM.IsDirty}"/>
                                            <Button Grid.Row="1" Grid.Column="2" Margin="5" Content="..."
                                                    Command="{Binding DataContext.SelectPgRestoreFilePathCommand, ElementName=_DbTab}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_Password}"/>
                                            <RadioButton Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" GroupName="pgpassword_input" Margin="5" 
                                                         Content="{x:Static properties:Resources.RadioButton_Password_ShowInputWindow}"
                                                         IsChecked="{Binding PasswordInputVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, Mode=TwoWay, ConverterParameter=InputWindow}"
                                                         attached:DirtyIndicator.IsDirty="{Binding PasswordInputVM.IsDirty}"/>
                                            <RadioButton Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" GroupName="pgpassword_pgpass" Margin="5" 
                                                         Content="{x:Static properties:Resources.RadioButton_Password_SpecifyPgpassConf}"
                                                         IsChecked="{Binding PasswordInputVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, Mode=TwoWay, ConverterParameter=PgPassConf}"
                                                         attached:DirtyIndicator.IsDirty="{Binding PasswordInputVM.IsDirty}"/>
                                        </Grid>
                                    </GroupBox>
                                    <!-- Microsoft Access -->
                                    <GroupBox Grid.Row="2" Grid.Column="0" Header="{x:Static properties:Resources.GroupHeader_KichoFugetsu}" DataContext="{Binding AccessSettingVM}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" 
                                                       Text="{x:Static properties:Resources.TextBlock_Access_Provider}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" 
                                                      ItemsSource="{Binding ProviderNameListVM.ItemList}" SelectedItem="{Binding ProviderNameListVM.SelectedItem, Mode=TwoWay}" DisplayMemberPath="Value"
                                                      attached:DirtyIndicator.IsDirty="{Binding ProviderNameListVM.IsDirty}"/>
                                        </Grid>
                                    </GroupBox>

                                    <Button Grid.Row="3" Grid.Column="0" Margin="5" 
                                            Content="{x:Static properties:Resources.Button_ReregisterDatabaseSetting}"
                                            Command="{Binding RestartForDbSettingCommand}"/>
                                </Grid>
                            </GroupBox>
                            <!-- バックアップ情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_BackUpInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="Header"/>
                                        <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition SharedSizeGroup="Button"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 個数 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                               Text="{x:Static properties:Resources.TextBlock_Count}"/>
                                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding BackUpNumVM.InputedValue}" MinValue="0" MaxValue="100"
                                                            attached:DirtyIndicator.IsDirty="{Binding BackUpNumVM.IsDirty}"/>
                                    <!-- フォルダパス -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center" 
                                               Text="{x:Static properties:Resources.TextBlock_FolderPath}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Grid.ColumnSpan="2" IsReadOnly="True" Text="{Binding BackUpFolderPathVM.InputedValue}"
                                             attached:DirtyIndicator.IsDirty="{Binding BackUpFolderPathVM.IsDirty}"/>
                                    <Button Grid.Row="1" Grid.Column="3" Margin="5" Content="..."
                                            Command="{Binding DataContext.SelectCsvFolderPathCommand, ElementName=_DbTab}"/>
                                    <!-- タイミング -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_Timing}"/>
                                    <GroupBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5">
                                        <GroupBox.Header>
                                            <CheckBox Content="{x:Static properties:Resources.CheckBox_Timing_MinimizingMainWindow}" IsChecked="{Binding IfBackUpAtMinimizingVM.InputedValue}"
                                                      attached:DirtyIndicator.IsDirty="{Binding IfBackUpAtMinimizingVM.IsDirty}"/>
                                        </GroupBox.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="{x:Static properties:Resources.TextBlock_Interval}"/>
                                    <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Margin="5" Value="{Binding BackUpIntervalAtMinimizingVM.InputedValue}" MinValue="0"
                                                            attached:DirtyIndicator.IsDirty="{Binding BackUpIntervalAtMinimizingVM.IsDirty}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="5" VerticalAlignment="Center" Text="{x:Static properties:Resources.TextBlock_MinutesUnit}"/>
                                        </Grid>
                                    </GroupBox>
                                    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                              Content="{x:Static properties:Resources.CheckBox_Timing_ClosingMainWindow}" IsChecked="{Binding IfBackUpAtClosingVM.InputedValue}"
                                              attached:DirtyIndicator.IsDirty="{Binding IfBackUpAtClosingVM.IsDirty}"/>
                                    <!-- 条件 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                               Text="{x:Static properties:Resources.TextBlock_BackUpCondition}"/>
                                    <RadioButton Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Content="{x:Static properties:Resources.RadioButton_BackUpCondition_Always}" 
                                                 IsChecked="{Binding BackUpConditionVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Always}"
                                                 attached:DirtyIndicator.IsDirty="{Binding BackUpConditionVM.IsDirty}" GroupName="BackupCondition"/>
                                    <RadioButton Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Content="{x:Static properties:Resources.RadioButton_BackUpCondition_Updated}" 
                                                 IsChecked="{Binding BackUpConditionVM.InputedValue, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Updated}"
                                                 attached:DirtyIndicator.IsDirty="{Binding BackUpConditionVM.IsDirty}" GroupName="BackupCondition"/>
                                    <!-- 通知 -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_Notifications}"/>
                                    <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" 
                                              Content="{x:Static properties:Resources.CheckBox_Notifications_MinimizingMainWindow}" IsChecked="{Binding IfNotifyBackUpAtMinimizingVM.InputedValue}"
                                              attached:DirtyIndicator.IsDirty="{Binding IfNotifyBackUpAtMinimizingVM.IsDirty}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="1" Margin="5" Content="{x:Static properties:Resources.Button_Save}" Command="{Binding SaveDbSettingsCommand}"/>
                </Grid>
            </TabItem>
            
            <!-- その他 -->
            <TabItem x:Name="_OtherTab" DataContext="{Binding OtherTabVM}">
                <TabItem.Header>
                    <TextBlock Text="{x:Static properties:Resources.TabHeader_OtherSettings}" TextAlignment="Center"/>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 言語情報 -->
                    <GroupBox Grid.Row="0" Header="{x:Static properties:Resources.GroupHeader_LanguageInformation}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 言語 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_Language}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" ItemsSource="{Binding CultureNameListVM.ItemList}" 
                                              SelectedItem="{Binding CultureNameListVM.SelectedItem, Mode=TwoWay}" DisplayMemberPath="Value"
                                              attached:DirtyIndicator.IsDirty="{Binding CultureNameListVM.IsDirty}"/>
                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" 
                                            Content="{x:Static properties:Resources.Button_ApplyLanguage}" Command="{Binding RestartForLanguageCommand}"/>
                        </Grid>
                    </GroupBox>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- バージョン情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_VersionInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Header"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 通知 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_Notifications}"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="5" 
                                              Content="{x:Static properties:Resources.CheckBox_Notifications_LaunchingApplication}" IsChecked="{Binding IfNotifyLatestAtAppLaunchedVM.InputedValue}"
                                              attached:DirtyIndicator.IsDirty="{Binding IfNotifyLatestAtAppLaunchedVM.IsDirty}"/>
                                </Grid>
                            </GroupBox>
                            <!-- カレンダー情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_CalendarInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="Header"/>
                                        <ColumnDefinition Width="100" SharedSizeGroup="Number"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition SharedSizeGroup="Button"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 開始月 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" Text="{x:Static properties:Resources.TextBlock_StartMonth}"/>
                                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding StartMonthVM.InputedValue}" MinValue="1" MaxValue="12"
                                                            attached:DirtyIndicator.IsDirty="{Binding StartMonthVM.IsDirty}"/>
                                    <!-- 祝日 -->
                                    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" Header="{x:Static properties:Resources.GroupHeader_Holiday}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition SharedSizeGroup="Button"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- URL -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="URI" Margin="5" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Text="{Binding NationalHolidayCsvURIVM.InputedValue, UpdateSourceTrigger=PropertyChanged}"
                                                     attached:DirtyIndicator.IsDirty="{Binding NationalHolidayCsvURIVM.IsDirty}"/>
                                            <!-- エンコード -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="{x:Static properties:Resources.TextBlock_TextEncoding}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" ItemsSource="{Binding NationalHolidayTextEncodingListVM.ItemList}" 
                                                      SelectedItem="{Binding NationalHolidayTextEncodingListVM.SelectedItem}" DisplayMemberPath="Value"
                                                      attached:DirtyIndicator.IsDirty="{Binding NationalHolidayTextEncodingListVM.IsDirty}"/>
                                            <!-- 列番号 -->
                                            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                                      Header="{x:Static properties:Resources.GroupHeader_ColumnIndex}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition SharedSizeGroup="Header"/>
                                                        <ColumnDefinition SharedSizeGroup="Number"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition SharedSizeGroup="Button"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 日付 -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" 
                                                               Text="{x:Static properties:Resources.TextBlock_Date}"/>
                                                    <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding NationalHolidayCsvDateIndexVM.InputedValue}" MinValue="1"
                                                                            attached:DirtyIndicator.IsDirty="{Binding NationalHolidayCsvDateIndexVM.IsDirty}"/>
                                                </Grid>

                                            </GroupBox>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </GroupBox>
                            <!-- ウィンドウ情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_WindowInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="Header"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition SharedSizeGroup="Button"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 保存対象 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" 
                                               Text="{x:Static properties:Resources.TextBlock_SaveTarget}"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="5" 
                                              Content="{x:Static properties:Resources.CheckBox_SaveTarget_PositionWithoutMainWindow}" IsChecked="{Binding IsPositionSavedVM.InputedValue}"
                                              attached:DirtyIndicator.IsDirty="{Binding IsPositionSavedVM.IsDirty}"/>

                                    <DataGrid Grid.Row="1" Grid.ColumnSpan="3" Margin="5" ItemsSource="{Binding WindowSettingVMList}"
                                              Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                              IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                              AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="True"
                                              HorizontalGridLinesBrush="#FFC0C0C0" VerticalGridLinesBrush="#FFC0C0C0" AlternatingRowBackground="#FFFFFFE0" FontSize="10.5" FontFamily="Meiryo">

                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Title" Width="*" Binding="{Binding Title}"/>
                                            <DataGridTextColumn Header="Left" Width="*" Binding="{Binding Left}"/>
                                            <DataGridTextColumn Header="Top" Width="*" Binding="{Binding Top}"/>
                                            <DataGridTextColumn Header="Width" Width="*" Binding="{Binding Width}"/>
                                            <DataGridTextColumn Header="Height" Width="*" Binding="{Binding Height}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" 
                                            Visibility="{Binding App_IsDebug, Source={StaticResource Settings}, Converter={StaticResource BoolVisibilityConverter}}"
                                            Content="{x:Static properties:Resources.Button_InitializeWindowPositionAndSize}"
                                            Command="{Binding InitializeWindowSettingCommand}"/>
                                </Grid>
                            </GroupBox>
                            <!-- ログ情報 -->
                            <GroupBox Header="{x:Static properties:Resources.GroupHeader_LogInformation}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 操作ログ -->
                                    <GroupBox Grid.Row="0">
                                        <GroupBox.Header>
                                            <CheckBox Content="{x:Static properties:Resources.GroupHeader_OperationLog}" IsChecked="{Binding IfOutputOperationLogVM.InputedValue}"
                                                      attached:DirtyIndicator.IsDirty="{Binding IfOutputOperationLogVM.IsDirty}"/>
                                        </GroupBox.Header>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 個数 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                                       Text="{x:Static properties:Resources.TextBlock_Count}"/>
                                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding OperationLogNumVM.InputedValue}" MinValue="0" MaxValue="100"
                                                                    attached:DirtyIndicator.IsDirty="{Binding OperationLogNumVM.IsDirty}"/>
                                            <!-- 出力レベル -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                                       Text="{x:Static properties:Resources.TextBlock_OutoutLogLevel}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" ItemsSource="{Binding LogLevelListVM.ItemList}"
                                                      SelectedItem="{Binding LogLevelListVM.SelectedItem, Mode=TwoWay}" DisplayMemberPath="Value"
                                                      attached:DirtyIndicator.IsDirty="{Binding LogLevelListVM.IsDirty}"/>
                                        </Grid>
                                    </GroupBox>

                                    <!-- ウィンドウログ -->
                                    <GroupBox Grid.Row="1">
                                        <GroupBox.Header>
                                            <CheckBox Content="{x:Static properties:Resources.GroupHeader_WindowLog}" IsChecked="{Binding IfOutputWindowLogVM.InputedValue}"
                                                      attached:DirtyIndicator.IsDirty="{Binding IfOutputWindowLogVM.IsDirty}"/>
                                        </GroupBox.Header>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 個数 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                               Text="{x:Static properties:Resources.TextBlock_Count}"/>
                                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding WindowLogNumVM.InputedValue}" MinValue="0" MaxValue="100"
                                                                    attached:DirtyIndicator.IsDirty="{Binding WindowLogNumVM.IsDirty}"/>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 例外ログ -->
                                    <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.GroupHeader_UnhandledExceptionLog}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="Header"/>
                                                <ColumnDefinition SharedSizeGroup="Number"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 個数 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"
                                               Text="{x:Static properties:Resources.TextBlock_Count}"/>
                                            <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Margin="5" Value="{Binding UnhandledExceptionLogNumVM.InputedValue}" MinValue="1" MaxValue="100"
                                                                    attached:DirtyIndicator.IsDirty="{Binding UnhandledExceptionLogNumVM.IsDirty}"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Button Grid.Row="2" Margin="5" Content="{x:Static properties:Resources.Button_Save}" Command="{Binding SaveOtherSettingsCommand}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
